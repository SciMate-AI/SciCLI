          "$ref": "#/definitions/agent"
        },
        "task": {
          "$ref": "#/definitions/agent"
        },
        "title": {
          "$ref": "#/definitions/agent"
        }
      },
      "type": "object"
    },
    "automation": {
      "description": "Agent automation defaults",
      "properties": {
        "workMode": {
          "default": "interactive",
          "description": "Execution mode for the coder agent",
          "enum": [
            "interactive",
            "auto",
            "ultrawork"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "contextPaths": {
      "default": [
        ".github/copilot-instructions.md",
        ".cursorrules",
        ".cursor/rules/",
        "CLAUDE.md",
        "CLAUDE.local.md",
        "SCICLI.md",
        "SCICLI.local.md",
        "scicli.md",
        "scicli.local.md",
        "SciCLI.md",
        "SciCLI.local.md"
      ],
      "description": "Context paths for the application",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "data": {
      "description": "Storage configuration",
      "properties": {
        "directory": {
          "default": ".scicli",
          "description": "Directory where application data is stored",
          "type": "string"
        }
      },
      "required": [
        "directory"
      ],
      "type": "object"
    },
    "debug": {
      "default": false,
      "description": "Enable debug mode",
      "type": "boolean"
    },
    "debugLSP": {
      "default": false,
      "description": "Enable LSP debug mode",
      "type": "boolean"
    },
    "lsp": {
      "additionalProperties": {
        "description": "LSP configuration for a language",
        "properties": {
          "args": {
            "description": "Command arguments for the LSP server",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "command": {
            "description": "Command to execute for the LSP server",
            "type": "string"
          },
          "disabled": {
            "default": false,
            "description": "Whether the LSP is disabled",
            "type": "boolean"
          },
          "options": {
            "description": "Additional options for the LSP server",
            "type": "object"
          }
        },
        "required": [
          "command"
        ],
        "type": "object"
      },
      "description": "Language Server Protocol configurations",
      "type": "object"
    },
    "mcpServers": {
      "additionalProperties": {
        "description": "MCP server configuration",
        "properties": {
          "args": {
            "description": "Command arguments for the MCP server",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "command": {
            "description": "Command to execute for the MCP server",
            "type": "string"
          },
          "env": {
            "description": "Environment variables for the MCP server",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "headers": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "HTTP headers for SSE type MCP servers",
            "type": "object"
          },
          "type": {
            "default": "stdio",
            "description": "Type of MCP server",
            "enum": [
              "stdio",
              "sse",
              "streamable-http"
            ],
            "type": "string"
          },
          "url": {
            "description": "URL for SSE type MCP servers",
            "type": "string"
          }
        },
        "type": "object"
      },
      "description": "Model Control Protocol server configurations",
      "type": "object"
    },
    "permissions": {
      "description": "Permission and auto-approval settings",
      "properties": {
        "allowCommandPrefixes": {
          "default": [],
          "description": "Shell command prefixes that can be auto-approved",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "autoApprove": {
          "default": false,
          "description": "Automatically approve tool actions allowed by the runtime policy",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "providers": {
      "additionalProperties": {
        "description": "Provider configuration",
        "properties": {
          "apiKey": {
            "description": "API key for the provider",
            "type": "string"
          },
          "disabled": {
            "default": false,
            "description": "Whether the provider is disabled",
            "type": "boolean"
          },
          "provider": {
            "description": "Provider type",
            "enum": [
              "anthropic",
              "openai",
              "gemini",
              "groq",
              "openrouter",
              "bedrock",
              "azure",
              "vertexai"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "description": "LLM provider configurations",
      "type": "object"
    },
    "skills": {
      "description": "Agent Skill discovery and enablement settings",
      "properties": {
        "disabled": {
          "default": [],
          "description": "Skill IDs or names to suppress from discovery",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "paths": {
          "default": [],
          "description": "Additional directories to scan for skill folders containing SKILL.md",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "tui": {
      "description": "Terminal User Interface configuration",
      "properties": {
        "altScreen": {
          "default": false,
          "description": "Start the TUI in the alternate screen buffer by default",
          "type": "boolean"
        },
        "linkAllAgentModels": {
          "default": true,
          "description": "When true, changing the selected model updates coder, task, summarizer, and title agents together",
          "type": "boolean"
        },
        "mouse": {
          "default": false,
          "description": "Capture mouse events in the TUI by default",
          "type": "boolean"
        },
        "theme": {
          "default": "scicli",
          "description": "TUI theme name",
          "enum": [
            "scicli",
            "opencode",
            "catppuccin",
            "dracula",
            "flexoki",
            "gruvbox",
            "monokai",
            "onedark",
            "tokyonight",
            "tron"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "wd": {
      "description": "Working directory for the application",
      "type": "string"
    }
  },
  "title": "SciCLI Configuration",
  "type": "object"
}
